{
  "name": "friendsmedicos",
  "version": "1.2.0",
  "description": "Friends Medicos Clinical & Stock Suite",
  "author": "Deepesh Siroha",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx bytenode --compile --electron main-app.js",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "test": "npm run build && playwright test --workers=1"
  },
  "dependencies": {
    "better-sqlite3": "^8.4.0",
    "bytenode": "^1.5.7",
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "jspdf": "^4.2.1",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.friendsmedicos.app",
    "productName": "FriendsMedicos",
    "icon": "build/icon.png",
    "files": [
      "dist-frontend/**/*",
      "main.js",
      "main-app.jsc",
      "preload.js",
      "build/icon.png",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/obj.target/**/*",
      "!node_modules/better-sqlite3/build/Release/sqlite3.a",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/better-sqlite3/build/Release/.deps/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
